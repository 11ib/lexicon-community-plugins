{
  "name": "lexicon-community-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community plugins for Lexicon DJ, with a test harness that runs them outside the app.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "validate": "node scripts/validate-configs.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "build": "node scripts/build-zips.mjs",
    "verify": "npm run lint && npm run validate && npm run check:permissions && npm run check:versions && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "espree": "^10.3.0",
    "vitest": "^2.1.8",
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
